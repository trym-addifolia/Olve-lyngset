{
  "name": "olvelyngset",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3077",
    "build": "next build",
    "start": "next start -p 3077",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/cf.mjs opennextjs-cloudflare deploy",
    "db:migrate": "node scripts/cf.mjs wrangler d1 migrations apply olvelyngset-maling --remote",
    "cf": "node scripts/cf.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.15",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "next": "15.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.156.2"
  }
}
