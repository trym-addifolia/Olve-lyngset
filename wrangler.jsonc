{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Addifolia account (CLOUDFLARE_ACCOUNT_ID in .cloudflare.env); never the Plastiks login
  "name": "olvelyngset",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext calls back into its own Worker (cache revalidation)
      "binding": "WORKER_SELF_REFERENCE",
      "service": "olvelyngset"
    }
  ],
  "d1_databases": [
    {
      // anonymous tallies: site_hits and booking_clicks (migrations/)
      "binding": "DB",
      "database_name": "olvelyngset-maling",
      // created 2026-11-17 on the Addifolia account (WEUR), 0001 migrated
      "database_id": "8ebc1667-b321-42f6-a68e-a0e06deea992",
      "migrations_dir": "migrations"
    }
  ],
  // preview host until launch: olvelyngset.hei-0de.workers.dev (noindex)
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Olve's comments become issues here (src/lib/kommentar/github.ts). Secrets:
  // KOMMENTAR_NOKKEL and GITHUB_KOMMENTAR_TOKEN (wrangler secret put).
  "vars": { "GITHUB_KOMMENTAR_REPO": "trym-addifolia/Olve-lyngset" }
}
